    "browser-automation",
    "ai-agent",
    "model-context-protocol"
  ],
  "author": "itbitez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itbitez/foxden-mcp.git"
  },
  "homepage": "https://github.com/itbitez/foxden-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "foxden-mcp": "bin/foxden-mcp.js",
    "foxden": "bin/foxden.js"
  },
  "files": [
    "bin",
    "lib",
    "NOTICE"
  ],
  "scripts": {
    "start": "node bin/foxden-mcp.js",
